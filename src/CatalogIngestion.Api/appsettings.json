{
  "ConnectionStrings": {
    "Catalog": "Data Source=data/catalog.db;Mode=ReadWriteCreate;Foreign Keys=True;Default Timeout=5;Pooling=True"
  },
  "Ingestion": {
    "MaxPayloadBytes": 5242880,
    "MaxItems": 10000,
    "MaxAttempts": 3,
    "PollIntervalMilliseconds": 250,
    "RetryBaseDelaySeconds": 2,
    "MaxRetainedDeadLetterPayloads": 20,
    "WorkerEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
